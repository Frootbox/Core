{% set v = view.getViewHelper('\\Frootbox\\Admin\\Viewhelper\\GeneralPurpose') %}

{{ front.addTab('Formular-Verwaltung', app.getUri('index')) }}
{{ front.addTab(form.title) }}

<br />

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link" href="{{ app.getUri('details', { formId: form.getId() }) }}">Formularfelder</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ app.getUri('config', { formId: form.getId() }) }}">Konfiguration</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="{{ app.getUri('archive', { formId: form.getId() }) }}">Anfragen</a>
    </li>
</ul>

<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">

        <div class="card">
            <div class="card-body">

                <h2>
                    Anfragen

                    <span class="headoptions">
                        <span class="dropdown">
                            <i class="far fa-bars dropdown-toggle" data-toggle="dropdown"></i>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" href="{{ app.getUri('ajaxExport', { formId: form.getId() }) }}">Daten exportieren</a>
                                <a class="dropdown-item ajax" data-confirm="Sollen wirklich ALLE Anfragen gelöscht werden?" href="{{ app.getUri('ajaxTruncate', { formId: form.getId() }) }}">Alle Anfragen löschen</a>
                            </div>
                        </span>
                    </span>

                </h2>

                {% if logs | length == 0 %}
                    <div class="message info">Es gibt keine Anfragen in diesem Formular.</div>
                {% else %}
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Absender</th>
                                <th>Datum</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>

                        {% for log in logs %}

                            {% set sender = log.getSender() %}
                            <tr data-log="{{ log.getId() }}" data-href="{{ app.getUri('archiveLog', { logId: log.getId(), page: pagination.page }) }}">
                                <td>
                                    <i class="far fa-user"></i>&nbsp;
                                    {{ sender.name }}
                                    &lt;{{ sender.email }}&gt;
                                </td>
                                <td>{{ log.getDate() | date('d.m.Y H:i') }} Uhr</td>
                                <td class="text-right">
                                    <a class="ajax" href="{{ app.getUri('ajaxArchiveLogSend', { logId: log.getId() }) }}"><i class="far fa-paper-plane icon"></i></a>
                                    <a class="ajax" data-confirm="Soll diese Anfrage wirklich gelöscht werden?" href="{{ app.getUri('ajaxArchiveLogDelete', { logId: log.getId() }) }}"><i class="far fa-trash icon"></i></a>
                                </td>
                            </tr>
                        {% endfor %}

                        </tbody>
                    </table>

                    <p class="text-muted">Seite {{ pagination.page }} von {{ pagination.pages }} · {{ pagination.total }} Anfragen</p>

                    {% if pagination.pages > 1 %}
                        <nav aria-label="Anfragen Seiten">
                            <ul class="pagination flex-wrap">
                                <li class="page-item {% if pagination.previousPage is empty %}disabled{% endif %}">
                                    {% if pagination.previousPage is empty %}
                                        <span class="page-link">Zurück</span>
                                    {% else %}
                                        <a class="page-link" href="{{ app.getUri('archive', { formId: form.getId(), page: pagination.previousPage }) }}">Zurück</a>
                                    {% endif %}
                                </li>

                                {% if pagination.firstPage > 1 %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ app.getUri('archive', { formId: form.getId(), page: 1 }) }}">1</a>
                                    </li>
                                    {% if pagination.firstPage > 2 %}
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    {% endif %}
                                {% endif %}

                                {% for page in pagination.firstPage..pagination.lastPage %}
                                    <li class="page-item {% if page == pagination.page %}active{% endif %}">
                                        {% if page == pagination.page %}
                                            <span class="page-link" aria-current="page">{{ page }}</span>
                                        {% else %}
                                            <a class="page-link" href="{{ app.getUri('archive', { formId: form.getId(), page: page }) }}">{{ page }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}

                                {% if pagination.lastPage < pagination.pages %}
                                    {% if pagination.lastPage < pagination.pages - 1 %}
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    {% endif %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ app.getUri('archive', { formId: form.getId(), page: pagination.pages }) }}">{{ pagination.pages }}</a>
                                    </li>
                                {% endif %}

                                <li class="page-item {% if pagination.nextPage is empty %}disabled{% endif %}">
                                    {% if pagination.nextPage is empty %}
                                        <span class="page-link">Weiter</span>
                                    {% else %}
                                        <a class="page-link" href="{{ app.getUri('archive', { formId: form.getId(), page: pagination.nextPage }) }}">Weiter</a>
                                    {% endif %}
                                </li>
                            </ul>
                        </nav>
                    {% endif %}
                {% endif %}

            </div>
        </div>

    </div>
</div>

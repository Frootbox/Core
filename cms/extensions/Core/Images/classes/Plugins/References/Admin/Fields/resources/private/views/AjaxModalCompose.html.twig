{% set v = view.getViewHelper('\\Frootbox\\Admin\\Viewhelper\\GeneralPurpose') %}

{{ view.set({
    'frame' : false,
}) }}

<form method="post" class="ajax" action="{{ plugin.getAdminUri('Fields', 'ajaxCreate') }}">

    <div class="modal-body">

        {% if not configuration.get('i18n.multiAliasMode') %}
            <div class="form-group">
                <label for="title">Titel</label>
                <input type="text" class="form-control" name="title" required id="title" placeholder="Titel">
            </div>
        {% else %}
            {% for language in configuration.get('i18n.languages') %}
                <div class="form-group">
                    <label for="title_{{ loop.index }}">Titel ({{ language }}){% if settings.default_language == language %}*{% endif %}</label>
                    <input type="text" {% if settings.default_language == language %}required{% endif %} class="form-control" id="title_{{ loop.index }}" name="titles[{{ language }}]" placeholder="Titel ({{ language }})">
                </div>
            {% endfor %}
        {% endif %}

    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">neues Feld hinzufügen</button>
    </div>

</form>


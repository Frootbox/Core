{{ front.addTab('Globaler Passwort-Schutz', app.getUri('index')) }}

<h2>Globaler Passwort-Schutz</h2>

<p>Schützt alle über das CMS erreichbaren Frontend-Seiten und -Routen. Administratoren mit aktiver Anmeldung behalten Zugriff.</p>

<form action="{{ app.getUri('ajaxUpdate') }}" method="post" class="ajax">
    <div class="form-group form-check">
        <input type="checkbox" class="form-check-input" id="globalPasswordEnabled" name="enabled" value="1" {% if enabled %}checked{% endif %}>
        <label class="form-check-label" for="globalPasswordEnabled">Passwort-Schutz aktivieren</label>
    </div>

    <div class="form-group">
        <label for="globalPassword">{% if hasPassword %}Neues Passwort{% else %}Passwort{% endif %}</label>
        <input type="password" class="form-control" id="globalPassword" name="password" autocomplete="new-password">
        {% if hasPassword %}<small class="form-text text-muted">Leer lassen, um das bisherige Passwort beizubehalten.</small>{% endif %}
    </div>

    <button type="submit" class="btn btn-primary">Speichern</button>
</form>

{% set v = view.getViewHelper('\\Frootbox\\Admin\\Viewhelper\\GeneralPurpose') %}

<script nonce="{{ settings.nonce }}">
    $(function () {
        var form = $('#updateForm');
        var modal = $('#fbxEditorGenericModal');
        var previous = modal.data('headlineFields');
        if (previous) { previous.destroy(); }
        var fields = FrootboxHeadlineFields.create(form[0]);
        modal.data('headlineFields', fields);
        modal.off('.headlineFields').one('hidden.bs.modal.headlineFields', function () {
            fields.destroy();
            modal.removeData('headlineFields');
        });
        modal.one('shown.bs.modal.headlineFields', function () { fields.focus(); });
        if (modal.hasClass('show')) { fields.focus(); }

        form.find('a.toggle-extended-config').on('click', function (event) {
            event.preventDefault();
            form.find('.extended-config').toggleClass('d-none');
        });

        function updateText(target, html) {
            // Preserve layout spans such as data-wrap and the supertitle span.
            var span = target.children('span');
            if (span.length === 1 && target.contents().length === 1) { span.html(html); }
            else { target.html(html); }
        }

        form.on('submit', function (event) {
            event.preventDefault();
            event.stopImmediatePropagation();
            fields.sync();
            form.find('[type="submit"]').prop('disabled', true);

            $.ajax({
                url: form.attr('action'),
                data: form.serialize(),
                type: 'POST',
                success: function (response) {
                    var matches = $('[data-uid="' + form.attr('data-uid') + '"]');
                    var wrapper = matches.filter('header').first();
                    if (!wrapper.length) { wrapper = matches.first(); }
                    var title = wrapper.is('header') ? wrapper.find('h1, h2, h3, h4, h5, h6').first() : wrapper;
                    var tag = response.headline.level;
                    if (tag && /^h[1-6]$/i.test(tag) && /^h[1-6]$/i.test(title.prop('tagName')) && tag !== title.prop('tagName')) {
                        var replacement = $(document.createElement(tag.toLowerCase()));
                        $.each(title[0].attributes, function (_, attribute) { replacement.attr(attribute.name, attribute.value); });
                        replacement.append(title.contents());
                        if (wrapper.is('header')) {
                            wrapper.removeClass(title.prop('tagName').toLowerCase()).addClass(tag.toLowerCase());
                        }
                        title.replaceWith(replacement);
                        title = replacement;
                    }
                    var head = title.find('.head').first();
                    updateText(head.length ? head : title, response.headline.text);

                    ['supertitle', 'subtitle'].forEach(function (name) {
                        if (!form.find('[name="' + name + '"]').length) { return; }
                        var target = wrapper.find('.' + name).first();
                        var html = response.headline[name] || '';
                        if (!html) { target.remove(); return; }
                        if (!target.length) {
                            target = $(wrapper.is('header') ? '<p>' : '<span>').addClass(name);
                            if (name === 'supertitle') { wrapper.prepend(target.addClass('super-title').append('<span></span>')); }
                            else { wrapper.append(target); }
                        }
                        updateText(target, html);
                    });
                    modal.modal('hide');
                },
                error: function (xhr) { alert(xhr.responseText); },
                complete: function () { form.find('[type="submit"]').prop('disabled', false); }
            });
        });
    });
</script>

<form id="updateForm" action="{{ controller.getActionUri('ajaxUpdate', { uid: get.get('uid') }) }}" method="post" data-uid="{{ get.get('uid') }}">

    {% set headlineLevel = (text.getConfig('level') | default(get.get('headlineTag'))) %}

    <div class="modal-header">
        <h5 class="modal-title">Überschrift bearbeiten</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body">

        <div class="form-group">
            <label for="headline"><b>Überschrift</b></label>
            <textarea data-headline-field class="form-control" id="headline" name="headline" placeholder="Überschrift">{{ fields.headline }}</textarea>
        </div>

        {% if not get.get('skipSuperTitle') %}
            <div class="form-group">
                <label for="supertitle">Übertitel</label>
                <textarea data-headline-field class="form-control" id="supertitle" name="supertitle" placeholder="Übertitel">{{ fields.supertitle }}</textarea>
            </div>
        {% endif %}

        <div class="form-group">
            <label for="subtitle">Untertitel</label>
            <textarea data-headline-field class="form-control" id="subtitle" name="subtitle" placeholder="Untertitel">{{ fields.subtitle }}</textarea>
        </div>

        <p><a class="toggle-extended-config" href="#">erweiterte Einstellungen</a></p>

        <div class="extended-config d-none">


            {{ text.getConfig('headlineLevel') }}

            <div class="form-row">
                <div class="form-group col-6">
                    <label for="headlineLevel">Überschrift-Ordnung</label>
                    <select class="form-control" id="headlineLevel" name="headlineLevel">
                        <option value="">unverändert</option>
                        <option {% if text.getConfig('level') == "H1" %}selected{% endif %} value="H1">1</option>
                        <option {% if text.getConfig('level') == "H2" %}selected{% endif %} value="H2">2</option>
                        <option {% if text.getConfig('level') == "H3" %}selected{% endif %} value="H3">3</option>
                        <option {% if text.getConfig('level') == "H4" %}selected{% endif %} value="H4">4</option>
                        <option {% if text.getConfig('level') == "H5" %}selected{% endif %} value="H5">5</option>
                        <option {% if text.getConfig('level') == "H6" %}selected{% endif %} value="H6">6</option>
                    </select>
                </div>
                <div class="form-group col-6">
                    <label for="textAlign">Text-Ausrichtung</label>
                    <select class="form-control" id="textAlign" name="textAlign">
                        <option value="">unverändert</option>
                        <option {% if text.getConfig('style.textAlign') == "left" %}selected{% endif %} value="left">links</option>
                        <option {% if text.getConfig('style.textAlign') == "center" %}selected{% endif %} value="center">zentriert</option>
                        <option {% if text.getConfig('style.textAlign') == "right" %}selected{% endif %} value="right">rechts</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-6">
                    <label for="color">Schriftfarbe</label>
                    <input type="text" class="form-control" id="fontColor" name="color" placeholder="Schriftfarbe" value="{{ text.getConfig('style.color') }}" />
                </div>
                <div class="form-group col-6">
                    <label for="fontSize">Schriftgröße</label>
                    <input type="text" class="form-control" id="fontSize" name="fontSize" placeholder="Schriftgröße" value="{{ text.getConfig('style.fontSize') }}" />
                </div>
            </div>


            <div class="form-group">
                <label for="elementId">Element-ID</label>
                <input type="text" class="form-control" id="elementId" name="elementId" placeholder="Element-ID" value="{{ text.getConfig('elementId') }}" />
            </div>

            {#
            <div class="form-row">
                <div class="col">
                    <div class="form-group">
                        <label for="elementId">Margin</label>
                        <input type="text" class="form-control" id="elementId" name="elementId" placeholder="Element-ID" value="{{ text.getConfig('elementId') }}" />
                    </div>
                </div>
                <div class="col">
                    <input type="text" class="form-control" placeholder="Last name">
                </div>
            </div>
            #}

        </div>

        <button type="submit" class="btn btn-primary">Speichern</button>

    </div>

</form>
